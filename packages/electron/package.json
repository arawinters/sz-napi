{
  "name": "@senzing/electron",
  "version": "0.1.0",
  "description": "Senzing Desktop SDK — exposes the Senzing SDK to Electron renderer processes via contextBridge/IPC",
  "exports": {
    "./main": {
      "types": "./dist/main/index.d.ts",
      "default": "./dist/main/index.js"
    },
    "./preload": {
      "types": "./dist/preload/index.d.ts",
      "default": "./dist/preload/index.js"
    },
    "./renderer": {
      "types": "./dist/renderer/types.d.ts"
    }
  },
  "scripts": {
    "build": "tsc"
  },
  "peerDependencies": {
    "@senzing/sdk": ">=0.1.0",
    "electron": ">=28.0.0"
  },
  "devDependencies": {
    "@senzing/sdk": "file:../sdk",
    "electron": "^35.0.0",
    "typescript": "^5.8.0",
    "@types/node": "^22.15.0"
  }
}
